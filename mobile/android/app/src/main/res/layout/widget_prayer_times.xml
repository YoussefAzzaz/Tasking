<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_prayer_times_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:layoutDirection="ltr"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp">

    <!-- LAYER 1: Top Small Header Line (Time + English Date + Arabic Hijri Date | Sunrise) -->
    <LinearLayout
        android:id="@+id/widget_prayer_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layoutDirection="ltr"
        android:orientation="horizontal">

        <!-- Left Cluster: Live Clock • Non-Arabic Gregorian Date • Arabic Hijri Date -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical|start"
            android:layoutDirection="ltr"
            android:orientation="horizontal">

            <TextClock
                android:id="@+id/widget_prayer_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:textColor="#FFFFFF"
                android:textSize="10dp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text=" • "
                android:textColor="#475569"
                android:textSize="9dp" />

            <TextView
                android:id="@+id/widget_prayer_gregorian"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Tue, 24 Nov"
                android:textColor="#CBD5E1"
                android:textDirection="ltr"
                android:textSize="9.5dp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text=" • "
                android:textColor="#475569"
                android:textSize="9dp" />

            <TextView
                android:id="@+id/widget_prayer_hijri"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/axis_arabic_naskh"
                android:gravity="start"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="13 جمادى الآخرة 1448"
                android:textColor="#7DD3FC"
                android:textDirection="rtl"
                android:textSize="9.5dp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Vertical Separator between Hijri Date and Chourok Time -->
        <ImageView
            android:layout_width="1dp"
            android:layout_height="12dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="#334155"
            android:contentDescription="Separator" />

        <!-- Right Cluster: Sunrise / Chourok Time -->
        <LinearLayout
            android:id="@+id/widget_prayer_sunrise_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_amber"
            android:gravity="center_vertical"
            android:layoutDirection="ltr"
            android:orientation="horizontal"
            android:paddingStart="5dp"
            android:paddingTop="1.5dp"
            android:paddingEnd="5dp"
            android:paddingBottom="1.5dp">

            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="3dp"
                android:contentDescription="Sunrise"
                android:src="@drawable/ic_sunrise_horizon" />

            <TextView
                android:id="@+id/widget_prayer_sunrise"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/axis_arabic_naskh"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="الشروق 07:12"
                android:textColor="#FCD34D"
                android:textDirection="rtl"
                android:textSize="9dp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Thin Cyber Horizontal Divider -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="#1E293B"
        android:contentDescription="Divider" />

    <!-- LAYER 2: Main Second Line (5 Prayers LTR Fajr->Isha | Vertical Separator | Remaining Time Timer) -->
    <LinearLayout
        android:id="@+id/widget_prayer_main_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:layoutDirection="ltr"
        android:orientation="horizontal">

        <!-- 5 Arabic Prayer Capsules Sorted Left to Right Starting with Fajr -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="5.0"
            android:gravity="center_vertical"
            android:layoutDirection="ltr"
            android:orientation="horizontal">

            <!-- 1. Fajr (الفجر) -->
            <LinearLayout
                android:id="@+id/widget_prayer_col_fajr"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="1.5dp"
                android:layout_weight="1"
                android:background="@drawable/widget_prayer_inactive_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <TextView
                    android:id="@+id/widget_prayer_name_fajr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/axis_arabic_naskh"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="الفجر"
                    android:textColor="#E2E8F0"
                    android:textSize="10dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_prayer_time_fajr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1.5dp"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="05:30"
                    android:textColor="#94A3B8"
                    android:textSize="9dp" />
            </LinearLayout>

            <!-- 2. Dhuhr (الظهر) -->
            <LinearLayout
                android:id="@+id/widget_prayer_col_dhuhr"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="1.5dp"
                android:layout_marginEnd="1.5dp"
                android:layout_weight="1"
                android:background="@drawable/widget_prayer_inactive_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <TextView
                    android:id="@+id/widget_prayer_name_dhuhr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/axis_arabic_naskh"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="الظهر"
                    android:textColor="#E2E8F0"
                    android:textSize="10dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_prayer_time_dhuhr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1.5dp"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="12:45"
                    android:textColor="#94A3B8"
                    android:textSize="9dp" />
            </LinearLayout>

            <!-- 3. Asr (العصر) -->
            <LinearLayout
                android:id="@+id/widget_prayer_col_asr"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="1.5dp"
                android:layout_marginEnd="1.5dp"
                android:layout_weight="1"
                android:background="@drawable/widget_prayer_inactive_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <TextView
                    android:id="@+id/widget_prayer_name_asr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/axis_arabic_naskh"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="العصر"
                    android:textColor="#E2E8F0"
                    android:textSize="10dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_prayer_time_asr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1.5dp"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="15:45"
                    android:textColor="#94A3B8"
                    android:textSize="9dp" />
            </LinearLayout>

            <!-- 4. Maghrib (المغرب) -->
            <LinearLayout
                android:id="@+id/widget_prayer_col_maghrib"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="1.5dp"
                android:layout_marginEnd="1.5dp"
                android:layout_weight="1"
                android:background="@drawable/widget_prayer_inactive_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <TextView
                    android:id="@+id/widget_prayer_name_maghrib"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/axis_arabic_naskh"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="المغرب"
                    android:textColor="#E2E8F0"
                    android:textSize="10dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_prayer_time_maghrib"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1.5dp"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="18:20"
                    android:textColor="#94A3B8"
                    android:textSize="9dp" />
            </LinearLayout>

            <!-- 5. Isha (العشاء) -->
            <LinearLayout
                android:id="@+id/widget_prayer_col_isha"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="1.5dp"
                android:layout_weight="1"
                android:background="@drawable/widget_prayer_inactive_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <TextView
                    android:id="@+id/widget_prayer_name_isha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/axis_arabic_naskh"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="العشاء"
                    android:textColor="#E2E8F0"
                    android:textSize="10dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_prayer_time_isha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1.5dp"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="19:45"
                    android:textColor="#94A3B8"
                    android:textSize="9dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Vertical Separator between 5 Prayers and Upcoming Prayer Countdown -->
        <ImageView
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="3dp"
            android:background="#334155"
            android:contentDescription="Separator" />

        <!-- Upcoming Prayer Live Countdown Timer Pill -->
        <LinearLayout
            android:id="@+id/widget_prayer_timer_box"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2.0"
            android:background="@drawable/widget_prayer_timer_dhuhr"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="3dp"
            android:paddingTop="2dp"
            android:paddingEnd="3dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/widget_prayer_next_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/axis_arabic_naskh"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="متبقي للظهر"
                android:textColor="#F59E0B"
                android:textDirection="rtl"
                android:textSize="9dp"
                android:textStyle="bold" />

            <Chronometer
                android:id="@+id/widget_prayer_chronometer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1.5dp"
                android:countDown="true"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textSize="11dp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
