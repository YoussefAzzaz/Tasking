<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_habit_streak_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header Row: Title+Hijri & Flame Streak Badge on Left, Progress Pill on Right -->
    <LinearLayout
        android:id="@+id/widget_habit_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_habit_header_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="AXIS • HABITS"
                android:textColor="#10B981"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <!-- Flame Streak Pill Badge -->
            <LinearLayout
                android:id="@+id/widget_habit_streak_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:background="@drawable/widget_streak_pill_zero"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp">

                <ImageView
                    android:id="@+id/widget_habit_flame_icon"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="Streak"
                    android:src="@drawable/ic_streak_flame" />

                <TextView
                    android:id="@+id/widget_habit_streak_days"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="0 DAYS"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/widget_habit_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_pill_emerald"
            android:paddingStart="7dp"
            android:paddingTop="3dp"
            android:paddingEnd="7dp"
            android:paddingBottom="3dp"
            android:text="0/0 DONE"
            android:textColor="#10B981"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Progress Section -->
    <LinearLayout
        android:id="@+id/widget_habit_progress_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_habit_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="0 of 0 habits completed today (0%)"
            android:textColor="#94A3B8"
            android:textSize="10sp" />

        <ProgressBar
            android:id="@+id/widget_habit_progressbar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progress_track" />
    </LinearLayout>

    <!-- Divider -->
    <ImageView
        android:id="@+id/widget_habit_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="5dp"
        android:background="#1E293B"
        android:contentDescription="Divider" />

    <!-- Habits Content Zone (Color-coded active rows or CTA empty state) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/widget_habits_list_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Habit Row 0 -->
            <LinearLayout
                android:id="@+id/widget_habit_row_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_habit_dot_0"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="7dp"
                    android:contentDescription="Color"
                    android:src="@drawable/widget_dot_white" />

                <TextView
                    android:id="@+id/widget_habit_name_0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#F1F5F9"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/widget_habit_status_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="○"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Habit Row 1 -->
            <LinearLayout
                android:id="@+id/widget_habit_row_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_habit_dot_1"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="7dp"
                    android:contentDescription="Color"
                    android:src="@drawable/widget_dot_white" />

                <TextView
                    android:id="@+id/widget_habit_name_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#F1F5F9"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/widget_habit_status_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="○"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Habit Row 2 -->
            <LinearLayout
                android:id="@+id/widget_habit_row_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_habit_dot_2"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="7dp"
                    android:contentDescription="Color"
                    android:src="@drawable/widget_dot_white" />

                <TextView
                    android:id="@+id/widget_habit_name_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#F1F5F9"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/widget_habit_status_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="○"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Habit Row 3 -->
            <LinearLayout
                android:id="@+id/widget_habit_row_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_habit_dot_3"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="7dp"
                    android:contentDescription="Color"
                    android:src="@drawable/widget_dot_white" />

                <TextView
                    android:id="@+id/widget_habit_name_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#F1F5F9"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/widget_habit_status_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="○"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Habit Row 4 -->
            <LinearLayout
                android:id="@+id/widget_habit_row_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_habit_dot_4"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="7dp"
                    android:contentDescription="Color"
                    android:src="@drawable/widget_dot_white" />

                <TextView
                    android:id="@+id/widget_habit_name_4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#F1F5F9"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/widget_habit_status_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="○"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Empty State CTA -->
        <LinearLayout
            android:id="@+id/widget_habits_empty_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Add"
                android:src="@drawable/ic_habit_plus" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Start your first streak today"
                android:textColor="#F1F5F9"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- Rotating Quote Footer -->
    <TextView
        android:id="@+id/widget_habit_quote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Consistency creates mastery • Tap to open"
        android:textColor="#64748B"
        android:textSize="9.5sp" />

</LinearLayout>
