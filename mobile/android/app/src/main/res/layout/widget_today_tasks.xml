<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_today_tasks_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <!-- Header Row -->
    <LinearLayout
        android:id="@+id/widget_tasks_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_tasks_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AXIS • TODAY"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_tasks_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_accent"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="0/0 DONE"
            android:textColor="#00E5FF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Task List Content -->
    <TextView
        android:id="@+id/widget_tasks_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_tasks_header"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:lineSpacingExtra="4dp"
        android:maxLines="5"
        android:text="No tasks scheduled for today."
        android:textColor="#F1F5F9"
        android:textSize="12sp" />

    <!-- Footer Cue -->
    <TextView
        android:id="@+id/widget_tasks_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:text="Tap to open Axis"
        android:textColor="#64748B"
        android:textSize="10sp" />

</RelativeLayout>
