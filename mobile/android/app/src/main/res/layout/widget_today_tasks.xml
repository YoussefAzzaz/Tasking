<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_today_tasks_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <!-- Top Header Row: Dynamic Time & Date on Left, Badge on Right -->
    <LinearLayout
        android:id="@+id/widget_tasks_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Time & Date Cluster -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Dynamic Local Time (ticks live via Android OS TextClock) -->
            <TextClock
                android:id="@+id/widget_tasks_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm a"
                android:format24Hour="HH:mm"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Today's Date -->
            <TextView
                android:id="@+id/widget_tasks_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="TODAY"
                android:textColor="#00E5FF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Right Badge & App Label -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_tasks_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_pill_accent"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="0/0 DONE"
                android:textColor="#00E5FF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_tasks_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="AXIS • TODAY"
                android:textColor="#64748B"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Divider Line using ImageView (RemoteViews-compliant) -->
    <ImageView
        android:id="@+id/widget_tasks_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/widget_tasks_header"
        android:layout_marginTop="8dp"
        android:background="#1E293B"
        android:contentDescription="Divider" />

    <!-- Task List Content: Today's tasks as shown right now -->
    <TextView
        android:id="@+id/widget_tasks_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_tasks_divider"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:lineSpacingExtra="4dp"
        android:maxLines="5"
        android:text="No tasks scheduled for today."
        android:textColor="#F1F5F9"
        android:textSize="12sp" />

    <!-- Footer Cue -->
    <TextView
        android:id="@+id/widget_tasks_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:text="Tap to open Axis"
        android:textColor="#475569"
        android:textSize="10sp" />

</RelativeLayout>
