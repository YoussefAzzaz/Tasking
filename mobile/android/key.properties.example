# =============================================================================
# Android Release Signing Configuration Example
# 1. Generate an upload keystore if you don't have one:
#    keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
# 2. Copy this file to `mobile/android/key.properties` (never commit key.properties to git)
# 3. Fill in your real keystore path and passwords below:
# =============================================================================
storePassword=YOUR_KEYSTORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=upload
storeFile=upload-keystore.jks
