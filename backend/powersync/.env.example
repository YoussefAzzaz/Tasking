# =============================================================================
# AXIS: PowerSync Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit .env to git.
#
# NOTE: PowerSync v1.26.1+ requires all !env variables to be prefixed "PS_"
# =============================================================================

# ── Postgres (source DB) ──────────────────────────────────────────────────────
# Local Supabase DB (from `supabase start` output):
# NOTE: Use host.docker.internal instead of 127.0.0.1 when running in Docker
PS_PG_URI=postgresql://postgres:postgres@host.docker.internal:54322/postgres?sslmode=disable

# ── Supabase Auth JWKS ────────────────────────────────────────────────────────
# Local: http://host.docker.internal:54321/auth/v1/.well-known/jwks.json
# Production: https://<your-project-ref>.supabase.co/auth/v1/.well-known/jwks.json
PS_JWKS_URI=http://host.docker.internal:54321/auth/v1/.well-known/jwks.json

# PS_MONGO_URI is set directly in docker-compose.yml (internal service name)
# Override here only if using an external MongoDB:
# PS_MONGO_URI=mongodb://powersync_mongo:27017/powersync
